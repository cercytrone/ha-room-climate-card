{
  "name": "ha-room-climate-card",
  "version": "2.5.0",
  "description": "Moderne Raumklima-Karte fuer Home Assistant: Temperatur, Luftfeuchte, Fenster, Bewegung, Thermostat und echter Verlaufs-Chart.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "private": false,
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "climate",
    "temperature",
    "chart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cercytrone/ha-room-climate-card.git"
  },
  "bugs": {
    "url": "https://github.com/cercytrone/ha-room-climate-card/issues"
  },
  "homepage": "https://github.com/cercytrone/ha-room-climate-card#readme",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "showcase": "node scripts/build-showcase.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "lit": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
