# ---------------------------------------------------------------
# Rezeptverwaltung – Konfigurationsvorlage (enthält KEINE Geheimnisse)
# Kopieren nach .env und Werte anpassen. .env niemals ins Git-Repository!
# ---------------------------------------------------------------
APP_NAME="Rezeptverwaltung"
APP_ENV=production
# Wird mit "php artisan key:generate" erzeugt:
APP_KEY=
APP_DEBUG=false
# Platzhalter – tatsächliche Adresse eintragen:
APP_URL=https://rezepte.example.org

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
# Passwort nur hier in der .env auf dem Server eintragen:
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# HTTPS ----------------------------------------------------------
# Erzeugte Links immer mit https:// (empfohlen, sobald das Zertifikat aktiv ist)
FORCE_HTTPS=true
# Nur setzen, wenn ein Proxy vor der Anwendung TLS terminiert und die
# Systemprüfung das empfiehlt. Kommagetrennte IP-Adressen/Netze, NIEMALS "*".
TRUSTED_PROXIES=

# E-Mail (optional) ---------------------------------------------
# Ohne SMTP bleibt MAIL_MAILER=log; Teilen per E-Mail-Programm funktioniert trotzdem.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Rezeptverwaltung -----------------------------------------------
IMAGE_MAX_MB=15
IMAGE_MAX_SIDE=12000
IMAGE_MAX_MEGAPIXELS=50
IMAGE_KEEP_ORIGINAL=true
IMPORT_CONNECT_TIMEOUT=5
IMPORT_TIMEOUT=15
IMPORT_MAX_HTML_MB=5
IMPORT_MAX_REDIRECTS=5
BACKUP_KEEP=7
BACKUP_MAX_AGE_DAYS=60
BACKUP_TIME=03:17
